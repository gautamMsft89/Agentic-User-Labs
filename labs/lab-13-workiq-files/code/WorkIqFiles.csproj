<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>agentic-user-labs-13-workiq-files-isolated</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\AgenticLabs.Common\AgenticLabs.Common.csproj" />
    <EmbeddedResource Include="..\workiq.manifest.json" LogicalName="WorkIqFiles.workiq.manifest.json" />
    <Content Include="..\workiq.manifest.json" Link="workiq.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\workiq\SKILL.md" LogicalName="WorkIqFiles.workiq/SKILL.md" />
    <EmbeddedResource Include="..\workiq\references\*.md" LogicalName="WorkIqFiles.workiq/references/%(Filename)%(Extension)" />
    <Content Include="..\workiq\SKILL.md" Link="workiq\SKILL.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\workiq\references\*.md" Link="workiq\references\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="WorkIqFiles.Validation" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.10.0" />
    <PackageReference Include="Microsoft.Identity.Web.AgentIdentities" Version="4.8.0" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.22.2" />
    <PackageReference Include="Microsoft.Teams.Apps" Version="2.1.0-preview-0011" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="OpenAI" Version="2.11.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
  </ItemGroup>
</Project>
